{
    "task_type": "feature_based",
    "model_name": "mlp",
    "dataset": "apollo",
    "gather_train_metrics": true,
    
    "use_extracted_features": true,
    "use_cpu": false,
    
    "deepspeed": null,
    "per_device_train_batch_size": 1024,
    "per_device_eval_batch_size": 1024,
    "gradient_accumulation_steps": 1,
    "lambda_decay": 0.001,

    "activate_discordance_epsilon_for_loss": true,

    "hidden_size": 8,
    "num_hidden_layers": 3,
    "value_layer_dropout": 0.0,
    "layer_activation": "Tanh",
    "final_layer_activation": "none",

    "use_validation_for_tendencies": false,
    "update_tendencies_every_n_steps": 20,

    "rew_center_coefficient": 0.01,
    "layer_normalization": "none",
    "learning_rate": 0.01,
    "grounding_learning_rate": 0.001,
    "lagrange_learning_rate": 1,
    "grounding_loss_tendency_update_ratio": 0.1,
    "max_grad_norm": 0.1,
    "use_metrics_or_losses_for_lagrange_updates": "losses",
    "use_exponential_moving_average_or_optimum_targets": "optimum",
    "grad_on_only_worst_value": false,
    "zero_constraint": true,
    "use_ideal_grounding_model": false,
    "loss_func_type": "DEFAULT",
    "loss_func_type_kwargs": null,
    "weight_decay": 0.003,
    "bf16": false,
    "num_train_epochs": 1000,
    "gradient_checkpointing": false,
    "optim": "adamw_torch_fused",
    "lr_scheduler_type": "constant",
    "max_length": 4096,
    "save_every_steps": 10000,
    "eval_every_steps": 100,

    "run_name": "apollo"
}