{
    "model_name": "HuggingFaceTB/SmolLM-135M-Instruct",
    "use_frozen_base_model": false,
    "use_embeddings": true,
    "use_cpu": false,
    "save_embedded_dataset": true,
    "cleanup_dataset_cache_files": true,
    "deepspeed": null,
    "per_device_train_batch_size": 128,
    "per_device_eval_batch_size": 128,
    "gradient_accumulation_steps": 5,
    "metrics_accumulation_steps": 5,
    "lambda_decay": 0.0005,

    "hidden_size": 1024,
    "num_hidden_layers": 3,
    "value_layer_dropout": 0.0,
    "layer_activation": "SiLU",
    "final_layer_activation": "none",

    "rew_center_coefficient": 0.01,
    "layer_normalization": "none",
    "learning_rate": 0.001,
    "grounding_learning_rate": 0.001,
    "lagrange_learning_rate": 0.1,
    "grounding_loss_tendency_update_ratio": 0.01,
    "max_grad_norm": 0.1,
    "use_metrics_or_losses_for_lagrange_updates": "losses",
    "use_exponential_moving_average_or_optimum_targets": "average",
    "grad_on_only_worst_value": false,
    "zero_constraint": true,
    "use_ideal_grounding_model": false,
    "loss_func_type": "DEFAULT",
    "loss_func_type_kwargs": null,
    "weight_decay": 0.001,
    "bf16": true,
    "num_train_epochs": 100,
    "dataset": "pku",
    "gradient_checkpointing": true,
    "optim": "paged_adamw_32bit",
    "lr_scheduler_type": "constant",
    "max_length": 4096,
    "run_name": "run_",
    "save_every_steps": 50000,
    "eval_every_steps": 100,
    "inner_optimization_iterations": 5
}
