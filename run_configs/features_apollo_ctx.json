{
    "task_type": "feature_based",
    "model_name": "mlp",
    "context_implementation": "NO_CONTEXT",
    "do_initialization": false,
    "do_vs_initialization": false,
    "direct_context_to_vs_relation": true,
    "vs_weight_initialization": "equal",
    "detach_vs_selection_for_value_system_weight_training": false,
    "detach_context_selection_for_value_system_selection": false,
    "ctx_coefficient": 0.0,
    "vs_selection_coefficient": 100.0,
    "entropy_coefficient": 0.0,
    "normalize_context_features": true,

    "vae_initial_temperature": 1.0,
    "vae_lambda_clustering": 1.0,
    "vae_pretrain_epochs": 50,

    "vae_latent_dim": 2,
    "vae_type": "ae", 
    "vae_dropout": 0.0,
    "vae_layer_activation": "LeakyReLU",
    "vae_reconstruction_loss": "mse", 
    "vae_final_encoder_layer_activation": "none",
    "vae_resampling_iterations": 1,
    "vae_n_hidden_layers": 4, 
    "vae_hidden_dim_size": 64,
    "vae_similarity": "euclidean",
    "vae_beta": 1.0,
    
    "training_initialization_data_size": 5000,
    "sharp_context_classification": true,
    "max_value_systems": 10,
    "max_contexts": 10,
    "gather_train_metrics": true,
    
    "use_extracted_features": true,
    "use_cpu": false,
    
    "deepspeed": null,
    "per_device_train_batch_size": 512,
    "per_device_eval_batch_size": 512,
    "gradient_accumulation_steps": 1,
    "lambda_decay": 0.001,

    "activate_discordance_epsilon_for_loss": false,

    "hidden_size": 4,
    "num_hidden_layers": 0,
    "value_layer_dropout": 0.0,
    "layer_activation": "Tanh",
    "layer_normalization": "none",
    "final_layer_activation": "none",

    "vs_hidden_size": 32,
    "vs_num_hidden_layers": 4,
    "vs_layer_dropout": 0.0,
    "vs_layer_activation": "Tanh",
    

    "use_validation_for_tendencies": false,
    "update_tendencies_every_n_steps": 20,

    "rew_center_coefficient": 0.000,
    
    "learning_rate": 0.0003,
    "grounding_learning_rate": 0.0003,
    "context_learning_rate": 0.0003,
    "lagrange_learning_rate": 0.1,
    "grounding_loss_tendency_update_ratio": 0.1,
    "max_grad_norm": 10.0,
    "use_metrics_or_losses_for_lagrange_updates": "losses",
    "use_exponential_moving_average_or_optimum_targets": "optimum",
    "grad_on_only_worst_value": false,
    "zero_constraint": true,
    "use_ideal_grounding_model": false,
    "loss_func_type": "DEFAULT",
    "loss_func_type_kwargs": null,
    "weight_decay": 0.01,
    "extra_weight_decay1": 0.0,
    "extra_weight_decay2": 0.0,
    "bf16": false,
    "num_train_epochs": 1000,
    "gradient_checkpointing": false,
    "optim": "adamw_torch_fused",
    "lr_scheduler_type": "constant",
    "save_every_steps": 1000000000,
    "eval_every_steps": 100,

    "run_name": "CtxApollo"
}